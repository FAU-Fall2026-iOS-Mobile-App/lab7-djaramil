# Copy to .env and fill in values from https://trussedportal.hpc.fau.edu/
# Never commit .env or share your API keys.

# Active LLM profile: chatgpt, gemini, or faullm
TRUSSED_PROVIDER=chatgpt

# --- ChatGPT (OpenAI / Azure) ---
CHATGPT_API_KEY=your-chatgpt-api-key-here
CHATGPT_MODEL=gpt-5.6-luna
CHATGPT_API_URL=https://trussed.eng.fau.edu/provider/generic/chat/completions

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=your-gemini-model-name
GEMINI_API_URL=https://trussed.eng.fau.edu/provider/generic/chat/completions

# --- FAU LLM ---
FAULLM_API_KEY=your-faullm-api-key-here
FAULLM_MODEL=your-faullm-model-name
FAULLM_API_URL=https://trussed.eng.fau.edu/provider/generic/chat/completions
